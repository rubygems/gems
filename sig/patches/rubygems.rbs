# Declare the RubyGems methods and errors used by Gems::Configuration, Gems::Identifiers, and Gems::Version
module Gem
  class SystemExitException < SystemExit
  end

  class ConfigFile
    def rubygems_api_key: () -> String?
    def api_keys: () -> Hash[untyped, String]
  end

  class Version
    include Comparable

    def self.correct?: (untyped version) -> bool
    def initialize: (untyped version) -> void
  end

  class NameTuple
    def initialize: (String? name, String? version, ?String? platform) -> void
    def full_name: () -> String
  end
end
