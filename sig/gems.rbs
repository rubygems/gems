module Gems
  VERSION: String

  type multipart_field = [Symbol | String, untyped, Hash[Symbol, String]]
  type gem_identifier = String | Gem | Version
  type version_identifier = String | Version | Gem
  type owner_identifier = String | Owner | Profile
  type user_identifier = String | Integer | Owner | Profile
  type web_hook_identifier = String | WebHook
  type api_key_identifier = String | APIKey
  type api_key_role_identifier = String | APIKeyRole
  type trusted_publisher_identifier = Integer | String | TrustedPublisher
  type oidc_provider_identifier = Integer | String | OIDCProvider
  type webauthn_verification_identifier = String | WebAuthnVerification
  type push_file = String | Pathname | File
  type push_attestations = Array[push_file] | push_file
  type request_body = Hash[Symbol | String, untyped] | Array[multipart_field] | String | File

  extend Configuration
  extend SingleForwardable

  private def self.def_delegator: (interned accessor, Symbol method, ?Symbol ali) -> void
  private def self.def_delegators: (interned accessor, *Symbol methods) -> void
  private def self.def_single_delegator: (interned accessor, Symbol method, ?Symbol ali) -> void
  private def self.def_single_delegators: (interned accessor, *Symbol methods) -> void
  private def self.delegate: (Hash[Symbol | Array[Symbol], Symbol] hash) -> void
  private def self.single_delegate: (Hash[Symbol | Array[Symbol], Symbol] hash) -> void

  self.@client: Client
  self.@client_values: Array[untyped]?
  self.@credential_values: Array[untyped]
  self.@connection_values: Array[untyped]

  CLIENT_MUTEX: Thread::Mutex
  CONNECTION_SETTINGS: Array[Symbol]

  def self.client: () -> Client
  def self.reset: () -> self
  private def self.rebuild_client: () -> Array[untyped]
  private def self.client_values: () -> Array[untyped]
  private def self.fallback_key: () -> String?
  private def self.credential_values: () -> Array[untyped]
  private def self.apply_credential_values: () -> Array[untyped]
  private def self.connection_values: () -> Array[untyped]
  private def self.apply_connection_values: () -> void

  def self.new: (?host: String, ?key: api_key_identifier?, ?username: String?, ?password: String?, ?otp: String?, ?id_token: String?, ?user_agent: String, ?open_timeout: Numeric, ?read_timeout: Numeric, ?write_timeout: Numeric, ?debug_output: IO?, ?proxy_url: String?, ?keep_alive_timeout: Numeric, ?max_redirects: Integer, ?max_retries: Integer, ?max_retry_delay: Numeric, ?ca_file: String?, ?ca_path: String?, ?cert_store: OpenSSL::X509::Store?, ?client_cert: OpenSSL::X509::Certificate?, ?client_key: OpenSSL::PKey::PKey?) -> Client
              | [T] (?host: String, ?key: api_key_identifier?, ?username: String?, ?password: String?, ?otp: String?, ?id_token: String?, ?user_agent: String, ?open_timeout: Numeric, ?read_timeout: Numeric, ?write_timeout: Numeric, ?debug_output: IO?, ?proxy_url: String?, ?keep_alive_timeout: Numeric, ?max_redirects: Integer, ?max_retries: Integer, ?max_retry_delay: Numeric, ?ca_file: String?, ?ca_path: String?, ?cert_store: OpenSSL::X509::Store?, ?client_cert: OpenSSL::X509::Certificate?, ?client_key: OpenSSL::PKey::PKey?) { (Client client) -> T } -> T
  def self.rubygem: (gem_identifier gem_name) -> Gem
  def self.timeframe_versions: (from: Time | String, ?to: (Time | String)?, ?page: Integer?) -> Array[Gem]
  def self.timeframe_versions_each: (from: Time | String, ?to: (Time | String)?) ?{ (Gem gem) -> void } -> Enumerator[Gem, void]
  def self.version: (gem_identifier gem_name, ?version_identifier? version, ?platform: String?, ?ruby_abi: String?) -> Version
  def self.contents: (gem_identifier gem_name, ?version_identifier? version, ?platform: String?, ?ruby_abi: String?) -> Hash[String, Hash[String, String]]
  def self.attestations: (gem_identifier gem_name, ?version_identifier? version, ?platform: String?) -> Array[Hash[String, untyped]]
  def self.search: (String query, ?page: Integer?) -> Array[Gem]
  def self.search_each: (String query) ?{ (Gem gem) -> void } -> Enumerator[Gem, void]
  def self.autocomplete: (String query, ?page: Integer?) -> Array[String]
  def self.owned_gems: (?user_identifier? user_handle) -> Array[Gem]
  def self.push: (push_file gem, ?host: String?, ?attestations: push_attestations?) -> String
  def self.yank: (gem_identifier gem_name, ?version_identifier? version, ?platform: String?, ?ruby_abi: String?) -> String
  def self.versions: (gem_identifier gem_name) -> Array[Version]
  def self.latest_version: (gem_identifier gem_name) -> String
  def self.total_downloads: () -> Integer
  def self.downloads: (gem_identifier gem_name, ?version_identifier? version, ?platform: String?) -> Downloads
  def self.most_downloaded: () -> Array[Version]
  def self.owners: (gem_identifier gem_name) -> Array[Owner]
  def self.add_owner: (gem_identifier gem_name, owner_identifier owner, ?role: (String | Symbol)?) -> String
  def self.update_owner: (gem_identifier gem_name, owner_identifier owner, role: String | Symbol) -> String
  def self.remove_owner: (gem_identifier gem_name, owner_identifier owner) -> String
  def self.web_hooks: () -> Array[WebHook]
  def self.add_web_hook: (gem_identifier gem_name, web_hook_identifier url) -> String
  def self.remove_web_hook: (gem_identifier gem_name, web_hook_identifier url) -> String
  def self.fire_web_hook: (gem_identifier gem_name, web_hook_identifier url) -> String
  def self.latest: () -> Array[Gem]
  def self.profile: (user_identifier user) -> Profile
  def self.me: () -> Profile
  def self.webauthn_verification: () -> WebAuthnVerification
  def self.webauthn_verification_status: (webauthn_verification_identifier verification) -> WebAuthnVerificationStatus
  def self.just_updated: () -> Array[Gem]
  def self.create_api_key: (String name, scopes: Array[Symbol | String] | Symbol | String, ?expires_at: (Time | String)?, ?rubygem_name: gem_identifier?, ?mfa: bool?) -> APIKey
  def self.update_api_key: (api_key_identifier key, scopes: Array[Symbol | String] | Symbol | String) -> String
  def self.exchange_trusted_publisher_token: (String id_token) -> APIKey
  def self.api_key_roles: () -> Array[APIKeyRole]
  def self.api_key_role: (api_key_role_identifier token) -> APIKeyRole
  def self.oidc_providers: () -> Array[OIDCProvider]
  def self.oidc_provider: (oidc_provider_identifier provider) -> OIDCProvider
  def self.oidc_id_tokens: () -> Array[OIDCIDToken]
  def self.oidc_id_token: (Integer | String id) -> OIDCIDToken
  def self.assume_api_key_role: (api_key_role_identifier token, String id_token) -> APIKey
  def self.reverse_dependencies: (gem_identifier gem_name, ?only: (String | Symbol)?) -> Array[String]
  def self.reverse_dependency_versions: (gem_identifier gem_name) -> Array[String]
  def self.trusted_publishers: (gem_identifier gem_name) -> Array[TrustedPublisher]
  def self.trusted_publisher: (gem_identifier gem_name, trusted_publisher_identifier trusted_publisher) -> TrustedPublisher
  def self.add_trusted_publisher: (gem_identifier gem_name, repository_owner: String, repository_name: String, workflow_filename: String, ?environment: String?, ?workflow_repository_owner: String?, ?workflow_repository_name: String?, ?type: String) -> TrustedPublisher
  def self.remove_trusted_publisher: (gem_identifier gem_name, trusted_publisher_identifier trusted_publisher) -> String

  module Configuration
    include CertificateOptions
    include Identifiers
    include Settings
    extend Settings::Declaration
    include URLValidation

    @key: String?
    @otp: String?

    DEFAULT_HOST: String
    DEFAULT_USER_AGENT: String

    attr_reader host: String
    def host=: (String host) -> void
    attr_accessor id_token: String?
    def key=: (api_key_identifier? key) -> void
    attr_writer otp: String?
    attr_accessor password: String?
    attr_accessor user_agent: String
    attr_accessor username: String?
    attr_accessor open_timeout: Numeric
    attr_accessor read_timeout: Numeric
    attr_accessor write_timeout: Numeric
    attr_accessor debug_output: IO?
    attr_reader proxy_url: String?
    def proxy_url=: (String? proxy_url) -> void
    attr_accessor keep_alive_timeout: Numeric
    attr_accessor max_redirects: Integer
    attr_accessor max_retries: Integer
    attr_accessor max_retry_delay: Numeric
    def self.extended: (Configuration base) -> void
    def key: () -> String?
    def otp: () -> String?
    def default_host: () -> String
    def default_key: (?String host) -> String?
    def default_otp: () -> String?
    def key_configured?: () -> bool
    def otp_configured?: () -> bool
    def configure: () { (self) -> void } -> self
    def reset: () -> self

    private

    def reset_credentials: () -> void
    def reset_connection: () -> void
  end

  class Authenticator
    AUTHENTICATION_HEADER: String

    def header: (Net::HTTPRequest? request) -> Hash[String, String]
    def inspect: () -> String
  end

  class APIKeyAuthenticator < Authenticator
    attr_reader key: String

    def initialize: (key: String) -> void
    def header: (Net::HTTPRequest? request) -> Hash[String, String]
  end

  class BasicAuthenticator < Authenticator
    attr_reader username: String
    attr_reader password: String

    def initialize: (username: String, password: String) -> void
    def header: (Net::HTTPRequest? request) -> Hash[String, String]
    def inspect: () -> String
  end

  class OTPAuthenticator < Authenticator
    OTP_HEADER: String

    attr_reader authenticator: Authenticator
    attr_reader otp: String

    def initialize: (authenticator: Authenticator, otp: String) -> void
    def header: (Net::HTTPRequest? request) -> Hash[String, String]
    def inspect: () -> String
  end

  class TrustedPublisherAuthenticator < Authenticator
    include JSONParsing

    EXCHANGE_TOKEN_PATH: String

    attr_reader id_token: String
    attr_reader host: String
    attr_reader connection: Connection
    attr_reader request_builder: RequestBuilder
    attr_reader redirect_handler: RedirectHandler
    attr_reader retry_handler: RetryHandler
    attr_reader exchange_path: String
    attr_reader api_key: String?

    @mutex: Thread::Mutex

    def initialize: (id_token: String, ?host: String, ?connection: Connection, ?request_builder: RequestBuilder, ?redirect_handler: RedirectHandler, ?retry_handler: RetryHandler, ?exchange_path: String) -> void
    def header: (Net::HTTPRequest? request) -> Hash[String, String]
    def inspect: () -> String
    def exchange_token!: () -> APIKey

    private

    def exchange!: () -> APIKey
    def exchange_response: () -> Net::HTTPResponse
  end

  module ClientCredentials
    include Identifiers
    include URLValidation

    @host: String
    @connection: Connection
    @request_builder: RequestBuilder
    @redirect_handler: RedirectHandler
    @retry_handler: RetryHandler
    @key_configured: bool
    @trusted_publisher_authenticator: TrustedPublisherAuthenticator?

    UNSET: untyped
    PASSWORD_ENDPOINT: Regexp

    attr_reader key: String?
    attr_reader username: String?
    attr_reader password: String?
    attr_reader otp: String?
    attr_reader id_token: String?
    attr_reader authenticator: Authenticator

    def key=: (api_key_identifier? key) -> void
    def username=: (String? username) -> void
    def password=: (String? password) -> void
    def otp=: (String? otp) -> void
    def id_token=: (String? id_token) -> void

    private

    def initialize_credentials: (key: api_key_identifier?, username: String?, password: String?, otp: String?, id_token: String?) -> void
    def resolve_key_for_host: () -> void
    def configured_key: () -> String?
    def authenticator_for: (String host) -> Authenticator
    def password_authenticator_for: (URI::Generic uri) -> Authenticator?
    def initialize_authenticator: () -> Authenticator
    def otp_authenticator: (Authenticator authenticator) -> Authenticator
    def basic_authenticator: () -> BasicAuthenticator?
    def trusted_publisher_authenticator: () -> TrustedPublisherAuthenticator?
    def api_key_authenticator: () -> APIKeyAuthenticator?
  end

  class Resource
    include DeepCopy

    self.@inspect_readers: Array[Symbol]?
    self.@identity_readers: Array[Symbol]?
    self.@attribute_names: Array[Symbol]?

    attr_reader attributes: Hash[String, untyped]

    def self.list: (Array[Hash[String | Symbol, untyped]] list) -> Array[instance]
    def self.inspect_with: (*Symbol readers) -> Array[Symbol]
    def self.inspect_readers: () -> Array[Symbol]
    def self.identified_by: (*Symbol readers) -> Array[Symbol]
    def self.identity_readers: () -> Array[Symbol]
    def self.attribute: (Symbol name, *(String | Symbol) keys) -> Symbol
    def self.predicate: (Symbol name, *(String | Symbol) keys) -> Symbol
    def self.time_attribute: (Symbol name, *(String | Symbol) keys) -> Symbol
    def self.attribute_names: () -> Array[Symbol]
    private def self.record_attribute: (Symbol name) -> Symbol
    private def self.keys_for: (Symbol name, Array[String | Symbol] keys) -> Array[String]
    def initialize: (Hash[String | Symbol, untyped] attributes) -> void
    def []: (String | Symbol key) -> untyped
    def deconstruct_keys: (Array[Symbol]? keys) -> Hash[Symbol, untyped]
    def to_h: () -> Hash[String, untyped]
    def inspect: () -> String
    def to_s: () -> String
    def identity: () -> (Array[untyped] | Hash[String, untyped])
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer

    private

    def inspect_values: () -> Hash[Symbol, untyped]
    def value_of: (Array[String] keys) -> untyped
    def parse_time: (untyped value) -> Time
  end

  module DeepCopy
    private

    def deep_freeze: (untyped value) -> untyped
    def deep_dup: (untyped value) -> untyped
  end

  class Dependency < Resource
    TYPES: Array[String]

    def name: () -> String?
    def requirements: () -> String?
  end

  module Dependencies : Resource
    def runtime_dependencies: () -> Array[Dependency]
    def development_dependencies: () -> Array[Dependency]

    private

    def dependencies_of: (String type) -> Array[Dependency]
  end

  interface _Build
    def platform: () -> String?
    def ruby_abi: () -> String?
  end

  module BuildSummary : Resource, _Build
    private

    def inspect_values: () -> Hash[Symbol, untyped]
  end

  interface _Ordered
    def name: () -> String?
    def platform: () -> String?
    def ruby_abi: () -> String?
    def gem_version: () -> ::Gem::Version?
  end

  module Ordering : _Ordered
    def <=>: (untyped other) -> Integer?
    def ordering: () -> Array[untyped]?

    private

    def gem_version_of: (untyped number) -> ::Gem::Version?
  end

  class Gem < Resource
    include BuildSummary
    include Dependencies
    include Ordering

    def name: () -> String?
    def version: () -> String?
    def gem_version: () -> ::Gem::Version?
    def version_created_at: () -> Time?
    def downloads: () -> Integer?
    def version_downloads: () -> Integer?
    def platform: () -> String?
    def ruby_abi: () -> String?
    def authors: () -> String?
    def info: () -> String?
    def licenses: () -> Array[String]?
    def metadata: () -> Hash[String, String]?
    def yanked?: () -> bool
    def sha: () -> String?
    def spec_sha: () -> String?
    def project_uri: () -> String?
    def gem_uri: () -> String?
    def homepage_uri: () -> String?
    def wiki_uri: () -> String?
    def documentation_uri: () -> String?
    def mailing_list_uri: () -> String?
    def source_code_uri: () -> String?
    def bug_tracker_uri: () -> String?
    def changelog_uri: () -> String?
    def funding_uri: () -> String?
  end

  class Version < Resource
    include BuildSummary
    include Dependencies
    include Ordering

    private def self.checksum_attribute: (Symbol name, String hex_key, String base64_key) -> Symbol
    def name: () -> String?
    def full_name: () -> String?
    def number: () -> String?
    def authors: () -> String?
    def built_at: () -> Time?
    def created_at: () -> Time?
    def description: () -> String?
    def summary: () -> String?
    def downloads_count: () -> Integer?
    def platform: () -> String?
    def ruby_abi: () -> String?
    def prerelease?: () -> bool
    def yanked?: () -> bool
    def licenses: () -> Array[String]?
    def requirements: () -> Array[String]?
    def ruby_version: () -> String?
    def rubygems_version: () -> String?
    def sha: () -> String?
    def spec_sha: () -> String?
    def metadata: () -> Hash[String, String]?
    def gem_version: () -> ::Gem::Version?

    private

    def decode_sha: (untyped value) -> String
  end

  class Owner < Resource
    ROLES: Array[String]

    def id: () -> Integer?
    def handle: () -> String?
    def email: () -> String?
    def role: () -> String?
  end

  class Profile < Resource
    def id: () -> Integer?
    def handle: () -> String?
    def email: () -> String?
    def mfa: () -> String?
    def warning: () -> String?
  end

  class TrustedPublisher < Resource
    GITHUB_ACTION: String

    private def self.publisher_attribute: (Symbol name) -> Symbol
    def id: () -> Integer?
    def type: () -> String?
    def name: () -> String?
    def repository_owner: () -> String?
    def repository_owner_id: () -> String?
    def repository_name: () -> String?
    def workflow_filename: () -> String?
    def environment: () -> String?
    def workflow_repository_owner: () -> String?
    def workflow_repository_name: () -> String?
    def publisher: () -> Hash[String, untyped]
  end

  class WebHook < Resource
    def gem_name: () -> String?
    def url: () -> String?
    def failure_count: () -> Integer?
  end

  class Downloads < Resource
    def full_name: () -> String?
    def total: () -> Integer?
    def version_downloads: () -> Integer?
  end

  class APIKey < Resource
    SCOPES: Array[Symbol]

    def key: () -> String
    def name: () -> String?
    def scopes: () -> Array[String]?
    def expires_at: () -> Time?
    def rubygem: () -> Gem?
  end

  class WebAuthnVerification < Resource
    def path: () -> String?
    def expires_at: () -> Time?
    def token: () -> String?
  end

  class WebAuthnVerificationStatus < Resource
    def status: () -> String?
    def code: () -> String?
    def message: () -> String?
  end

  class OIDCProvider < Resource
    def id: () -> Integer?
    def issuer: () -> String?
    def configuration: () -> Hash[String, untyped]?
    def jwks: () -> Hash[String, untyped]?
    def created_at: () -> Time?
    def updated_at: () -> Time?
  end

  class OIDCIDToken < Resource
    def api_key_role_token: () -> String?
    def jwt: () -> Hash[String, untyped]?
  end

  class APIKeyRole < Resource
    def id: () -> Integer?
    def name: () -> String?
    def token: () -> String?
    def provider_id: () -> Integer?
    def api_key_permissions: () -> Hash[String, untyped]?
    def access_policy: () -> Hash[String, untyped]?
    def created_at: () -> Time?
    def updated_at: () -> Time?
  end

  interface _Requests
    def host: () -> String
    def get: (String path, ?Hash[Symbol | String, untyped] params, ?headers: Hash[String, String], ?host: String?) -> String
    def delete: (String path, ?Hash[Symbol | String, untyped] params, ?headers: Hash[String, String], ?host: String?) -> String
    def post: (String path, ?request_body body, ?content_type: String?, ?headers: Hash[String, String], ?host: String?) -> String
    def put: (String path, ?request_body body, ?content_type: String?, ?headers: Hash[String, String], ?host: String?) -> String
    def patch: (String path, ?request_body body, ?content_type: String?, ?headers: Hash[String, String], ?host: String?) -> String
  end

  module Identifiers
    private

    def name_of: (gem_identifier? gem) -> String?
    def number_of: (version_identifier? version) -> String?
    def version_of: (gem_identifier? gem, version_identifier? version) -> version_identifier?
    def platform_of: (version_identifier? version) -> String?
    def ruby_abi_of: (version_identifier? version) -> String?
    def full_name_of: (gem_identifier gem, version_identifier version, ?String? platform) -> String
    def handle_of: (user_identifier owner) -> (String | Integer)?
    def slug_of: (user_identifier user) -> (String | Integer)?
    def url_of: (web_hook_identifier web_hook) -> String?
    def token_of: (api_key_role_identifier? role) -> String?
    def key_of: (api_key_identifier? api_key) -> String?
    def webauthn_token_of: (webauthn_verification_identifier? verification) -> String?
    def id_of: ((trusted_publisher_identifier | oidc_provider_identifier)? resource) -> (Integer | String)?
    def timestamp_of: ((Time | String)? time) -> String?
  end

  module API : Object, _Requests
    include ActivityEndpoints
    include APIKeyEndpoints
    include DownloadEndpoints
    include GemEndpoints
    include OwnerEndpoints
    include ProfileEndpoints
    include TrustedPublisherEndpoints
    include VersionEndpoints
    include WebHookEndpoints
  end

  module API::ActivityEndpoints : Object, _Requests
    include Identifiers
    include JSONParsing

    def latest: () -> Array[Gem]
    def just_updated: () -> Array[Gem]
  end

  module API::APIKeyEndpoints : Object, _Requests
    include Identifiers
    include JSONParsing
    include PathEscaping

    def create_api_key: (String name, scopes: Array[Symbol | String] | Symbol | String, ?expires_at: (Time | String)?, ?rubygem_name: gem_identifier?, ?mfa: bool?) -> APIKey
    def update_api_key: (api_key_identifier key, scopes: Array[Symbol | String] | Symbol | String) -> String
    def exchange_trusted_publisher_token: (String id_token) -> APIKey
    def api_key_roles: () -> Array[APIKeyRole]
    def api_key_role: (api_key_role_identifier token) -> APIKeyRole
    def oidc_providers: () -> Array[OIDCProvider]
    def oidc_provider: (oidc_provider_identifier provider) -> OIDCProvider
    def oidc_id_tokens: () -> Array[OIDCIDToken]
    def oidc_id_token: (Integer | String id) -> OIDCIDToken
    def assume_api_key_role: (api_key_role_identifier token, String id_token) -> APIKey

    private

    def connection: () -> Connection
    def request_builder: () -> RequestBuilder
    def redirect_handler: () -> RedirectHandler
    def retry_handler: () -> RetryHandler
    def scope_fields: (Array[Symbol | String] | Symbol | String scopes) -> Hash[Symbol, bool]
    def granted_scopes: (Hash[Symbol, bool] fields) -> Array[String]
  end

  module API::DownloadEndpoints : Object, _Requests, API::VersionEndpoints
    include Identifiers
    include JSONParsing
    include PathEscaping

    def total_downloads: () -> Integer
    def downloads: (gem_identifier gem_name, ?version_identifier? version, ?platform: String?) -> Downloads
    def most_downloaded: () -> Array[Version]

    private

    def gem_name_from: (Hash[String, untyped] version) -> String
  end

  module API::GemEndpoints : Object, _Requests, API::VersionEndpoints
    include Identifiers
    include JSONParsing
    include Pagination
    include PathEscaping

    UNNAMED_GEM_FILENAME: String

    def rubygem: (gem_identifier gem_name) -> Gem
    def search: (String query, ?page: Integer?) -> Array[Gem]
    def search_each: (String query) ?{ (Gem gem) -> void } -> Enumerator[Gem, void]
    def autocomplete: (String query, ?page: Integer?) -> Array[String]
    def owned_gems: (?user_identifier? user_handle) -> Array[Gem]
    def push: (push_file gem, ?host: String?, ?attestations: push_attestations?) -> String
    def yank: (gem_identifier gem_name, ?version_identifier? version, ?platform: String?, ?ruby_abi: String?) -> String
    def reverse_dependencies: (gem_identifier gem_name, ?only: (String | Symbol)?) -> Array[String]
    def reverse_dependency_versions: (gem_identifier gem_name) -> Array[String]

    private

    def validate_type: ((String | Symbol)? type) -> void
    def multipart_push_body: (File file, push_attestations attestations) -> Array[multipart_field]
    def list_of: (push_attestations attestations) -> Array[push_file]
    def filename_of: (File file) -> String
    def open_file: [T] (push_file file) { (File file) -> T } -> T
    def read_file: (push_file file) -> String
  end

  module API::OwnerEndpoints : Object, _Requests
    include Identifiers
    include JSONParsing
    include PathEscaping

    def owners: (gem_identifier gem_name) -> Array[Owner]
    def add_owner: (gem_identifier gem_name, owner_identifier owner, ?role: (String | Symbol)?) -> String
    def update_owner: (gem_identifier gem_name, owner_identifier owner, role: String | Symbol) -> String
    def remove_owner: (gem_identifier gem_name, owner_identifier owner) -> String

    private

    def validate_role: ((String | Symbol)? role) -> void
  end

  module API::ProfileEndpoints : Object, _Requests
    include Identifiers
    include JSONParsing
    include PathEscaping

    def profile: (user_identifier user) -> Profile
    def me: () -> Profile
    def webauthn_verification: () -> WebAuthnVerification
