module Gems
  VERSION: String

  type multipart_field = [Symbol | String, untyped] | [String, String, Hash[Symbol, String]]
  type gem_identifier = String | Gem | Version
  type version_identifier = String | Version
  type owner_identifier = String | Owner | Profile
  type user_identifier = String | Integer | Owner | Profile
  type web_hook_identifier = String | WebHook
  type api_key_identifier = String | APIKey
  type push_file = String | Pathname | File
  type request_body = Hash[Symbol | String, untyped] | Array[multipart_field] | String

  extend Configuration
  extend SingleForwardable

  self.@client: Client
  self.@credential_values: Array[untyped]?
  self.@connection_values: Array[untyped]

  CLIENT_MUTEX: Thread::Mutex
  CONNECTION_SETTINGS: Array[Symbol]

  def self.client: () -> Client
  def self.reset: () -> self
  def self.rebuild_client: () -> Array[untyped]
  def self.credential_values: () -> Array[untyped]
  def self.connection_values: () -> Array[untyped]
  def self.apply_connection_values: () -> void

  def self.new: (?host: String, ?key: api_key_identifier?, ?username: String?, ?password: String?, ?otp: String?, ?id_token: String?, ?user_agent: String, ?open_timeout: Numeric, ?read_timeout: Numeric, ?write_timeout: Numeric, ?debug_output: IO?, ?proxy_url: String?, ?keep_alive_timeout: Numeric, ?max_redirects: Integer, ?max_retries: Integer, ?max_retry_delay: Numeric) -> Client
  def self.rubygem: (gem_identifier gem_name) -> Gem
  def self.timeframe_versions: (from: Time | String, ?to: (Time | String)?, ?page: Integer?) -> Array[Gem]
  def self.timeframe_versions_each: (from: Time | String, ?to: (Time | String)?) ?{ (Gem gem) -> void } -> Enumerator[Gem, void]
  def self.version: (gem_identifier gem_name, version_identifier version, ?platform: String?) -> Version
  def self.contents: (gem_identifier gem_name, version_identifier version, ?platform: String?) -> Hash[String, Hash[String, String]]
  def self.attestations: (gem_identifier gem_name, version_identifier version, ?platform: String?) -> Array[Hash[String, untyped]]
  def self.search: (String query, ?page: Integer?) -> Array[Gem]
  def self.search_each: (String query) ?{ (Gem gem) -> void } -> Enumerator[Gem, void]
  def self.autocomplete: (String query) -> Array[String]
  def self.owned_gems: (?user_identifier? user_handle) -> Array[Gem]
  def self.push: (push_file gem, ?host: String?, ?attestations: Array[push_file]?) -> String
  def self.yank: (gem_identifier gem_name, ?version_identifier? version, ?platform: String?) -> String
  def self.unyank: (gem_identifier gem_name, ?version_identifier? version, ?platform: String?) -> String
  def self.versions: (gem_identifier gem_name) -> Array[Version]
  def self.latest_version: (gem_identifier gem_name) -> String
  def self.total_downloads: () -> Integer
  def self.downloads: (gem_identifier gem_name, ?version_identifier? version, ?platform: String?) -> Downloads
  def self.most_downloaded: () -> Array[Version]
  def self.owners: (gem_identifier gem_name) -> Array[Owner]
  def self.add_owner: (gem_identifier gem_name, owner_identifier owner, ?role: String?) -> String
  def self.update_owner: (gem_identifier gem_name, owner_identifier owner, role: String) -> String
  def self.remove_owner: (gem_identifier gem_name, owner_identifier owner) -> String
  def self.web_hooks: () -> Array[WebHook]
  def self.add_web_hook: (gem_identifier gem_name, web_hook_identifier url) -> String
  def self.remove_web_hook: (gem_identifier gem_name, web_hook_identifier url) -> String
  def self.fire_web_hook: (gem_identifier gem_name, web_hook_identifier url) -> String
  def self.latest: (?page: Integer?) -> Array[Gem]
  def self.latest_each: () ?{ (Gem gem) -> void } -> Enumerator[Gem, void]
  def self.profile: (user_identifier user) -> Profile
  def self.me: () -> Profile
  def self.just_updated: (?page: Integer?) -> Array[Gem]
  def self.just_updated_each: () ?{ (Gem gem) -> void } -> Enumerator[Gem, void]
  def self.create_api_key: (String name, ?expires_at: (Time | String)?, ?rubygem_name: gem_identifier?, ?mfa: bool?, **bool scopes) -> APIKey
  def self.update_api_key: (api_key_identifier key, **bool scopes) -> String
  def self.exchange_trusted_publisher_token: (String id_token) -> APIKey
  def self.reverse_dependencies: (gem_identifier gem_name, ?only: String?) -> Array[String]

  module Configuration
    include Identifiers
    include URLValidation

    @key: String?
    @otp: String?

    DEFAULT_HOST: String
    DEFAULT_USER_AGENT: String

    attr_reader host: String
    def host=: (String host) -> void
    attr_accessor id_token: String?
    def key=: (api_key_identifier? key) -> void
    attr_writer otp: String?
    attr_accessor password: String?
    attr_accessor user_agent: String
    attr_accessor username: String?
    attr_accessor open_timeout: Numeric
    attr_accessor read_timeout: Numeric
    attr_accessor write_timeout: Numeric
    attr_accessor debug_output: IO?
    attr_reader proxy_url: String?
    def proxy_url=: (String? proxy_url) -> void
    attr_accessor keep_alive_timeout: Numeric
    attr_accessor max_redirects: Integer
    attr_accessor max_retries: Integer
    attr_accessor max_retry_delay: Numeric

    def self.extended: (Configuration base) -> void
    def key: () -> String?
    def otp: () -> String?
    def default_host: () -> String
    def default_key: (?String host) -> String?
    def default_otp: () -> String?
    def key_configured?: () -> bool
    def otp_configured?: () -> bool
    def configure: () { (self) -> void } -> self
    def reset: () -> self

    private

    def reset_credentials: () -> void
    def reset_connection: () -> void
  end

  class Authenticator
    AUTHENTICATION_HEADER: String

    def header: (Net::HTTPRequest? request) -> Hash[String, String]
    def inspect: () -> String
  end

  class APIKeyAuthenticator < Authenticator
    attr_reader key: String

    def initialize: (key: String) -> void
    def header: (Net::HTTPRequest? request) -> Hash[String, String]
  end

  class BasicAuthenticator < Authenticator
    attr_reader username: String
    attr_reader password: String

    def initialize: (username: String, password: String) -> void
    def header: (Net::HTTPRequest? request) -> Hash[String, String]
    def inspect: () -> String
  end

  class OTPAuthenticator < Authenticator
    OTP_HEADER: String

    attr_reader authenticator: Authenticator
    attr_reader otp: String

    def initialize: (authenticator: Authenticator, otp: String) -> void
    def header: (Net::HTTPRequest? request) -> Hash[String, String]
    def inspect: () -> String
  end

  class TrustedPublisherAuthenticator < Authenticator
    include JSONParsing

    EXCHANGE_TOKEN_PATH: String
    JSON_CONTENT_TYPE: String

    attr_reader id_token: String
    attr_reader host: String
    attr_reader connection: Connection
    attr_reader request_builder: RequestBuilder
    attr_reader api_key: String?

    @mutex: Thread::Mutex

    def initialize: (id_token: String, ?host: String, ?connection: Connection, ?request_builder: RequestBuilder) -> void
    def header: (Net::HTTPRequest? request) -> Hash[String, String]
    def inspect: () -> String
    def exchange_token!: () -> APIKey
  end

  module ClientCredentials
    include Identifiers

    @host: String
    @connection: Connection
    @request_builder: RequestBuilder
    @key_configured: bool
    @trusted_publisher_authenticator: TrustedPublisherAuthenticator?

    UNSET: untyped

    attr_reader key: String?
    attr_reader username: String?
    attr_reader password: String?
    attr_reader otp: String?
    attr_reader id_token: String?
    attr_reader authenticator: Authenticator

    def key=: (api_key_identifier? key) -> void
    def username=: (String? username) -> void
    def password=: (String? password) -> void
    def otp=: (String? otp) -> void
    def id_token=: (String? id_token) -> void

    private

    def initialize_credentials: (key: api_key_identifier?, username: String?, password: String?, otp: String?, id_token: String?) -> void
    def resolve_key_for_host: () -> void
    def configured_key: () -> String?
    def credentials_configured?: () -> bool
    def initialize_authenticator: () -> Authenticator
    def otp_authenticator: (Authenticator authenticator) -> Authenticator
    def basic_authenticator: () -> BasicAuthenticator?
    def trusted_publisher_authenticator: () -> TrustedPublisherAuthenticator?
    def api_key_authenticator: () -> APIKeyAuthenticator?
  end

  class Resource
    self.@inspect_readers: Array[Symbol]?
    self.@identity_readers: Array[Symbol]?
    self.@attribute_names: Array[Symbol]?

    attr_reader attributes: Hash[String, untyped]

    def self.list: (Array[Hash[String | Symbol, untyped]] list) -> Array[instance]
    def self.inspect_with: (*Symbol readers) -> Array[Symbol]
    def self.inspect_readers: () -> Array[Symbol]
    def self.identified_by: (*Symbol readers) -> Array[Symbol]
    def self.identity_readers: () -> Array[Symbol]
    def self.attribute: (Symbol name, *(String | Symbol) keys) -> Symbol
    def self.predicate: (Symbol name, *(String | Symbol) keys) -> Symbol
    def self.time_attribute: (Symbol name, *(String | Symbol) keys) -> Symbol
    def self.attribute_names: () -> Array[Symbol]
    def self.record_attribute: (Symbol name) -> Symbol
    def self.keys_for: (Symbol name, Array[String | Symbol] keys) -> Array[String]
    def initialize: (Hash[String | Symbol, untyped] attributes) -> void
    def []: (String | Symbol key) -> untyped
    def deconstruct_keys: (Array[Symbol]? keys) -> Hash[Symbol, untyped]
    def to_h: () -> Hash[String, untyped]
    def inspect: () -> String
    def identity: () -> (Array[untyped] | Hash[String, untyped])
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer

    private

    def value_of: (Array[String] keys) -> untyped
    def parse_time: (untyped value) -> Time
    def deep_freeze: (untyped value) -> untyped
  end

  class Dependency < Resource
    def name: () -> String?
    def requirements: () -> String?
  end

  class Gem < Resource
    def name: () -> String?
    def version: () -> String?
    def version_created_at: () -> Time?
    def downloads: () -> Integer?
    def version_downloads: () -> Integer?
    def platform: () -> String?
    def authors: () -> String?
    def info: () -> String?
    def licenses: () -> Array[String]?
    def metadata: () -> Hash[String, String]?
    def yanked?: () -> bool
    def sha: () -> String?
    def spdx_identifier: () -> String?
    def project_uri: () -> String?
    def gem_uri: () -> String?
    def homepage_uri: () -> String?
    def wiki_uri: () -> String?
    def documentation_uri: () -> String?
    def mailing_list_uri: () -> String?
    def source_code_uri: () -> String?
    def bug_tracker_uri: () -> String?
    def changelog_uri: () -> String?
    def funding_uri: () -> String?
    def runtime_dependencies: () -> Array[Dependency]
    def development_dependencies: () -> Array[Dependency]

    private

    def dependencies_of: (String type) -> Array[Dependency]
  end

  class Version < Resource
    def name: () -> String?
    def full_name: () -> String?
    def number: () -> String?
    def authors: () -> String?
    def built_at: () -> Time?
    def created_at: () -> Time?
    def description: () -> String?
    def summary: () -> String?
    def downloads_count: () -> Integer?
    def platform: () -> String?
    def prerelease?: () -> bool
    def yanked?: () -> bool
    def licenses: () -> Array[String]?
    def requirements: () -> Array[String]?
    def ruby_version: () -> String?
    def rubygems_version: () -> String?
    def sha: () -> String?
    def spdx_identifier: () -> String?
    def metadata: () -> Hash[String, String]?

    private

    def decode_sha: (untyped value) -> String
  end

  class Owner < Resource
    def id: () -> Integer?
    def handle: () -> String?
    def email: () -> String?
    def role: () -> String?
  end

  class Profile < Resource
    def id: () -> Integer?
    def handle: () -> String?
    def email: () -> String?
    def mfa: () -> String?
    def warning: () -> String?
  end

  class WebHook < Resource
    def gem_name: () -> String?
    def url: () -> String?
    def failure_count: () -> Integer?
  end

  class Downloads < Resource
    def total: () -> Integer?
    def version_downloads: () -> Integer?
  end

  class APIKey < Resource
    SCOPES: Array[Symbol]

    def key: () -> String
    def name: () -> String?
    def scopes: () -> Array[String]?
    def expires_at: () -> Time?
  end

  interface _Requests
    def host: () -> String
    def get: (String path, ?Hash[Symbol | String, untyped] params, ?headers: Hash[String, String], ?host: String?) -> String
    def delete: (String path, ?Hash[Symbol | String, untyped] params, ?headers: Hash[String, String], ?host: String?) -> String
    def post: (String path, ?request_body body, ?content_type: String?, ?headers: Hash[String, String], ?host: String?) -> String
    def put: (String path, ?request_body body, ?content_type: String?, ?headers: Hash[String, String], ?host: String?) -> String
    def patch: (String path, ?request_body body, ?content_type: String?, ?headers: Hash[String, String], ?host: String?) -> String
  end

  module Identifiers
    private

    def name_of: (gem_identifier? gem) -> String?
    def number_of: (version_identifier? version) -> String?
    def version_of: (gem_identifier? gem, version_identifier? version) -> version_identifier?
    def platform_of: (version_identifier? version) -> String?
    def full_name_of: (gem_identifier gem, version_identifier version, ?String? platform) -> String
    def handle_of: (user_identifier owner) -> (String | Integer)?
    def slug_of: (user_identifier user) -> (String | Integer)?
    def url_of: (web_hook_identifier web_hook) -> String?
    def key_of: (api_key_identifier? api_key) -> String?
    def timestamp_of: ((Time | String)? time) -> String?
  end

  module API : Object, _Requests
    include ActivityEndpoints
    include APIKeyEndpoints
    include DownloadEndpoints
    include GemEndpoints
    include OwnerEndpoints
    include ProfileEndpoints
    include VersionEndpoints
    include WebHookEndpoints
  end

  module API::ActivityEndpoints : Object, _Requests
    include Identifiers
    include JSONParsing
    include Pagination

    def latest: (?page: Integer?) -> Array[Gem]
    def latest_each: () ?{ (Gem gem) -> void } -> Enumerator[Gem, void]
    def just_updated: (?page: Integer?) -> Array[Gem]
    def just_updated_each: () ?{ (Gem gem) -> void } -> Enumerator[Gem, void]
  end

  module API::APIKeyEndpoints : Object, _Requests
    include Identifiers
    include JSONParsing

    def create_api_key: (String name, ?expires_at: (Time | String)?, ?rubygem_name: gem_identifier?, ?mfa: bool?, **bool scopes) -> APIKey
    def update_api_key: (api_key_identifier key, **bool scopes) -> String
    def exchange_trusted_publisher_token: (String id_token) -> APIKey

    private

    def connection: () -> Connection
    def request_builder: () -> RequestBuilder
    def validate_scopes: (Hash[Symbol, bool] scopes) -> void
  end

  module API::DownloadEndpoints : Object, _Requests, API::VersionEndpoints
    include Identifiers
    include JSONParsing
    include PathEscaping

    def total_downloads: () -> Integer
    def downloads: (gem_identifier gem_name, ?version_identifier? version, ?platform: String?) -> Downloads
    def most_downloaded: () -> Array[Version]

    private

    def gem_name_from: (Hash[String, untyped] version) -> String
  end

  module API::GemEndpoints : Object, _Requests, API::VersionEndpoints
    include Identifiers
    include JSONParsing
    include Pagination
    include PathEscaping

    def rubygem: (gem_identifier gem_name) -> Gem
    def search: (String query, ?page: Integer?) -> Array[Gem]
    def search_each: (String query) ?{ (Gem gem) -> void } -> Enumerator[Gem, void]
    def autocomplete: (String query) -> Array[String]
    def owned_gems: (?user_identifier? user_handle) -> Array[Gem]
    def push: (push_file gem, ?host: String?, ?attestations: Array[push_file]?) -> String
    def yank: (gem_identifier gem_name, ?version_identifier? version, ?platform: String?) -> String
    def unyank: (gem_identifier gem_name, ?version_identifier? version, ?platform: String?) -> String
    def reverse_dependencies: (gem_identifier gem_name, ?only: String?) -> Array[String]

    private

    def multipart_push_body: (push_file gem, Array[push_file] attestations) -> Array[multipart_field]
    def read_file: (push_file file) -> String
    def path_of: (push_file file) -> String
  end

  module API::OwnerEndpoints : Object, _Requests
    include Identifiers
    include JSONParsing
    include PathEscaping

    def owners: (gem_identifier gem_name) -> Array[Owner]
    def add_owner: (gem_identifier gem_name, owner_identifier owner, ?role: String?) -> String
    def update_owner: (gem_identifier gem_name, owner_identifier owner, role: String) -> String
    def remove_owner: (gem_identifier gem_name, owner_identifier owner) -> String
  end

  module API::ProfileEndpoints : Object, _Requests
    include Identifiers
    include JSONParsing
    include PathEscaping

    def profile: (user_identifier user) -> Profile
    def me: () -> Profile
  end

  module API::VersionEndpoints : Object, _Requests
    include Identifiers
    include JSONParsing
    include Pagination
    include PathEscaping

    def versions: (gem_identifier gem_name) -> Array[Version]
    def latest_version: (gem_identifier gem_name) -> String
    def version: (gem_identifier gem_name, version_identifier version, ?platform: String?) -> Version
    def contents: (gem_identifier gem_name, version_identifier version, ?platform: String?) -> Hash[String, Hash[String, String]]
    def attestations: (gem_identifier gem_name, version_identifier version, ?platform: String?) -> Array[Hash[String, untyped]]
    def timeframe_versions: (from: Time | String, ?to: (Time | String)?, ?page: Integer?) -> Array[Gem]
    def timeframe_versions_each: (from: Time | String, ?to: (Time | String)?) ?{ (Gem gem) -> void } -> Enumerator[Gem, void]
  end

  module API::WebHookEndpoints : Object, _Requests
    include Identifiers
    include JSONParsing

    WEB_HOOK_GEM_NAMES: Hash[String, String]

    def web_hooks: () -> Array[WebHook]
    def add_web_hook: (gem_identifier gem_name, web_hook_identifier url) -> String
    def remove_web_hook: (gem_identifier gem_name, web_hook_identifier url) -> String
    def fire_web_hook: (gem_identifier gem_name, web_hook_identifier url) -> String
  end

  class Client
    include API
    extend Forwardable
    include ClientCredentials
    include URLValidation

    @connection: Connection
    @request_builder: RequestBuilder
    @redirect_handler: RedirectHandler
    @retry_handler: RetryHandler
    @response_parser: ResponseParser

    attr_reader host: String

    def host=: (String host) -> void
    def inspect: () -> String
    def open_timeout: () -> Numeric
    def read_timeout: () -> Numeric
    def write_timeout: () -> Numeric
    def proxy_url: () -> String?
    def debug_output: () -> IO?
    def open_timeout=: (Numeric open_timeout) -> void
    def read_timeout=: (Numeric read_timeout) -> void
    def write_timeout=: (Numeric write_timeout) -> void
    def proxy_url=: (String? proxy_url) -> void
    def debug_output=: (IO? debug_output) -> void
    def keep_alive_timeout: () -> Numeric
    def keep_alive_timeout=: (Numeric keep_alive_timeout) -> void
    def max_redirects: () -> Integer
    def max_redirects=: (Integer max_redirects) -> void
    def max_retries: () -> Integer
    def max_retries=: (Integer max_retries) -> void
    def max_retry_delay: () -> Numeric
    def max_retry_delay=: (Numeric max_retry_delay) -> void
    def user_agent: () -> String
    def user_agent=: (String user_agent) -> void

    def initialize: (?host: String, ?key: api_key_identifier?, ?username: String?, ?password: String?, ?otp: String?, ?id_token: String?, ?user_agent: String, ?open_timeout: Numeric, ?read_timeout: Numeric, ?write_timeout: Numeric, ?debug_output: IO?, ?proxy_url: String?, ?keep_alive_timeout: Numeric, ?max_redirects: Integer, ?max_retries: Integer, ?max_retry_delay: Numeric) -> void
    def close: () -> self
    def get: (String path, ?Hash[Symbol | String, untyped] params, ?headers: Hash[String, String], ?host: String?) -> String
    def delete: (String path, ?Hash[Symbol | String, untyped] params, ?headers: Hash[String, String], ?host: String?) -> String
    def post: (String path, ?request_body body, ?content_type: String?, ?headers: Hash[String, String], ?host: String?) -> String
    def put: (String path, ?request_body body, ?content_type: String?, ?headers: Hash[String, String], ?host: String?) -> String
    def patch: (String path, ?request_body body, ?content_type: String?, ?headers: Hash[String, String], ?host: String?) -> String

    private

    attr_reader connection: Connection
    attr_reader request_builder: RequestBuilder

    def execute_request: (Symbol http_method, String path, host: String?, headers: Hash[String, String], ?params: Hash[Symbol | String, untyped], ?body: request_body?, ?content_type: String?) -> String
    def perform: (request: Net::HTTPRequest, authenticator: Authenticator, body: request_body?, content_type: String?, headers: Hash[String, String]) -> Net::HTTPResponse

    def authenticator_for: (String host) -> Authenticator
    def same_origin?: (String host, String other) -> bool
    def origin: (String host) -> [String?, String?, Integer?]

    def build_uri: (String host, String path) -> URI::Generic
  end

  class Error < StandardError
  end

  GemError: singleton(Error)

  class HTTPError < Error
    include RetryAfter

    attr_reader response: Net::HTTPResponse
    attr_reader code: Integer

    def initialize: (response: Net::HTTPResponse) -> void
    def retry_after: () -> Integer?

    private

    def error_message: (Net::HTTPResponse response) -> String
  end

  class ClientError < HTTPError
  end

  class ServerError < HTTPError
  end

  class BadRequest < ClientError
  end

  class Unauthorized < ClientError
  end

  class Forbidden < ClientError
  end

  class NotFound < ClientError
  end

  class Conflict < ClientError
  end

  class UnprocessableEntity < ClientError
  end

  class TooManyRequests < ClientError
  end

  class InternalServerError < ServerError
  end

  class BadGateway < ServerError
  end

  class ServiceUnavailable < ServerError
  end

  class GatewayTimeout < ServerError
  end

  class NetworkError < Error
    WRAPPED: Array[singleton(IOError) | singleton(Net::HTTPBadResponse) | singleton(Net::ProtocolError) | singleton(OpenSSL::SSL::SSLError) | singleton(SocketError) | singleton(SystemCallError) | singleton(Timeout::Error) | singleton(Zlib::Error)]
  end

  class TooManyRedirects < Error
  end

  class NoLatestVersion < Error
  end

  class InvalidResponse < Error
    attr_reader body: String

    def initialize: (body: String, ?message: String) -> void
  end

  module PathEscaping
    private

    def escape: (untyped value) -> String
  end

  module JSONParsing
    SHAPE_ERRORS: Array[singleton(KeyError) | singleton(NoMethodError) | singleton(TypeError)]

    private

    def parse_json: (String body) -> untyped
                  | [T] (String body) { (untyped json) -> T } -> T
  end

  class RedactedOutput
    REDACTION: String
    CREDENTIALS: Array[Regexp]

    @output: IO

    attr_reader output: IO

    def initialize: (IO output) -> void
    def <<: (String string) -> self
  end

  class ConnectionPool
    include Idempotence

    @connections: Hash[untyped, [Net::HTTP, untyped]]
    @mutex: Thread::Mutex

    def initialize: () -> void
    def checkout: (request: Net::HTTPRequest, settings: untyped, keep_alive_timeout: Numeric) { () -> Net::HTTP } -> Net::HTTP
    def checkin: (request: Net::HTTPRequest, http_client: Net::HTTP, settings: untyped, keep_alive_timeout: Numeric) -> void
    def discard: (Net::HTTP? http_client) -> void
    def take: (untyped key, untyped settings) -> Net::HTTP?
    def store: (untyped key, Net::HTTP http_client, untyped settings) -> bool
    def close: () -> self

    private

    def delete: (untyped key) -> Net::HTTP?
    def keep_alive?: (Net::HTTPRequest request, Numeric keep_alive_timeout) -> bool
    def pool_key: (Net::HTTPRequest request) -> [String?, String?, Integer?]
  end

  class Connection
    include URLValidation

    @pool: ConnectionPool

    DEFAULT_OPEN_TIMEOUT: Numeric
    DEFAULT_READ_TIMEOUT: Numeric
    DEFAULT_WRITE_TIMEOUT: Numeric
    DEFAULT_KEEP_ALIVE_TIMEOUT: Numeric

    attr_accessor open_timeout: Numeric
    attr_accessor read_timeout: Numeric
    attr_accessor write_timeout: Numeric
    attr_accessor keep_alive_timeout: Numeric
    attr_accessor debug_output: IO?
    attr_reader proxy_url: String?
    attr_reader proxy_uri: URI::Generic?

    def proxy_host: () -> String?
    def proxy_port: () -> Integer?
    def proxy_user: () -> String?
    def proxy_pass: () -> String?

    def initialize: (?open_timeout: Numeric, ?read_timeout: Numeric, ?write_timeout: Numeric, ?debug_output: IO?, ?proxy_url: String?, ?keep_alive_timeout: Numeric) -> void
    def inspect: () -> String
    def perform: (request: Net::HTTPRequest) -> Net::HTTPResponse
    def close: () -> self
    def proxy_url=: (String? proxy_url) -> void

    private

    attr_reader pool: ConnectionPool

    def settings: () -> Array[untyped]
    def parse_proxy_uri: (String proxy_url) -> URI::HTTP
    def redact: (String? url) -> String?
    def decode: (String? component) -> String?
    def build_http_client: (URI::Generic uri) -> Net::HTTP
    def proxy_arguments_for: (URI::Generic uri) -> [String?, Integer?, String?, String?, bool?]
    def configure_http_client: (Net::HTTP http_client) -> Net::HTTP
  end

  class RequestBuilder
    DEFAULT_USER_AGENT: String
    FORM_URLENCODED: String
    MULTIPART_FORM_DATA: String
    OCTET_STREAM: String
    HTTP_METHODS: Hash[Symbol, singleton(Net::HTTP::Get) | singleton(Net::HTTP::Post) | singleton(Net::HTTP::Put) | singleton(Net::HTTP::Patch) | singleton(Net::HTTP::Delete)]

    attr_accessor user_agent: String

    def initialize: (?user_agent: String) -> void
    def build: (http_method: Symbol, uri: URI::Generic, ?params: Hash[Symbol | String, untyped], ?body: request_body?, ?content_type: String?, ?headers: Hash[String, String], ?authenticator: Authenticator) -> Net::HTTPRequest

    private

    def create_request: (http_method: Symbol, uri: URI::Generic, params: Hash[Symbol | String, untyped]) -> Net::HTTPRequest
    def add_query_params: (URI::Generic uri, Hash[Symbol | String, untyped] params) -> URI::Generic
    def add_headers: (request: Net::HTTPRequest, headers: Hash[String, String]) -> void
    def add_body: (request: Net::HTTPRequest, body: request_body?, content_type: String?) -> void
    def add_authentication: (request: Net::HTTPRequest, authenticator: Authenticator) -> void
  end

  class RedirectHandler
    DEFAULT_MAX_REDIRECTS: Integer
    METHOD_PRESERVING_CODES: Array[Integer]

    attr_accessor max_redirects: Integer
    attr_reader connection: Connection
    attr_reader request_builder: RequestBuilder

    def initialize: (?connection: Connection, ?request_builder: RequestBuilder, ?max_redirects: Integer) -> void
    def handle: (response: Net::HTTPResponse, request: Net::HTTPRequest, ?authenticator: Authenticator, ?body: request_body?, ?content_type: String?, ?headers: Hash[String, String], ?redirect_count: Integer) -> Net::HTTPResponse

    private

    def follow: (response: Net::HTTPResponse, request: Net::HTTPRequest, uri: URI::HTTP, authenticator: Authenticator, body: request_body?, content_type: String?, headers: Hash[String, String], redirect_count: Integer) -> Net::HTTPResponse
    def same_origin?: (URI::Generic uri, URI::Generic other) -> bool
    def origin: (URI::Generic uri) -> [String?, String?, Integer?]
    def build_new_uri: (Net::HTTPResponse response, Net::HTTPRequest request) -> URI::HTTP?
    def build_request: (request: Net::HTTPRequest, uri: URI::Generic, response_code: Integer, authenticator: Authenticator, body: request_body?, content_type: String?, headers: Hash[String, String]) -> Net::HTTPRequest
  end

  class ResponseParser
    ERROR_MAP: Hash[Integer, singleton(HTTPError)]
    STATUS_CLASS_ERRORS: Hash[Integer, singleton(HTTPError)]

    def parse: (response: Net::HTTPResponse) -> String

    private

    def error: (Net::HTTPResponse response) -> HTTPError
    def error_class: (Net::HTTPResponse response) -> singleton(HTTPError)
  end

  module URLValidation
    private

    def validate_host: (String host) -> String
    def parse_proxy_uri: (String proxy_url) -> URI::HTTP
    def http_url?: (untyped host) -> bool
    def redact: (String? url) -> String?
  end

  module RetryAfter
    private

    def retry_after_of: (Net::HTTPResponse response) -> Integer?
  end

  module Idempotence
    IDEMPOTENT_METHODS: Array[String]

    private

    def idempotent?: (Net::HTTPRequest request) -> bool
  end

  module Pagination
    FIRST_PAGE: Integer

    private

    def each_page: [T] (^(T) -> void | nil block) { (Integer page) -> Array[T] } -> Enumerator[T, void]
  end

  interface _Random
    def rand: () -> Float
  end

  class RetryHandler
    include Idempotence
    include RetryAfter

    DEFAULT_MAX_RETRIES: Integer
    DEFAULT_MAX_RETRY_DELAY: Numeric
    RETRIED_STATUSES: Array[Integer]

    attr_accessor max_retries: Integer
    attr_accessor max_retry_delay: Numeric
    attr_reader random: _Random

    def initialize: (?max_retries: Integer, ?max_retry_delay: Numeric, ?random: _Random) -> void
    def handle: (request: Net::HTTPRequest) { () -> Net::HTTPResponse } -> Net::HTTPResponse

    private

    def attempt: (request: Net::HTTPRequest, retries: Integer) { () -> Net::HTTPResponse } -> Net::HTTPResponse?
    def wait: (Numeric delay) -> nil
    def retry_delay: (response: Net::HTTPResponse, request: Net::HTTPRequest, retries: Integer) -> Numeric?
    def network_retry_delay: (request: Net::HTTPRequest, retries: Integer) -> Numeric?
    def retryable?: (Net::HTTPRequest request, Integer retries) -> bool
    def capped: (Integer delay) -> Integer?
    def retry?: (Net::HTTPResponse response) -> bool
    def backoff: (Integer retries) -> Numeric
  end
end
